# Ecommerce Label Manager Environment Variables
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SENTRY_DSN=

# Persistent data directory. Use a mounted persistent volume in production.
LABEL_MANAGER_DATA_DIR=./data

# Automation and agent authentication. Generate long random values.
CRON_SECRET=
INGESTION_WEBHOOK_SECRET=
PRINT_AGENT_TOKEN=

# Marketplace label feeds. Each endpoint may return application/pdf or
# JSON: { "files": [{ "name": "labels.pdf", "base64": "..." }] }
FLIPKART_LABEL_FEED_URL=
FLIPKART_LABEL_FEED_TOKEN=
MEESHO_LABEL_FEED_URL=
MEESHO_LABEL_FEED_TOKEN=
MYNTRA_LABEL_FEED_URL=
MYNTRA_LABEL_FEED_TOKEN=
AMAZON_LABEL_FEED_URL=
AMAZON_LABEL_FEED_TOKEN=
SNAPDEAL_LABEL_FEED_URL=
SNAPDEAL_LABEL_FEED_TOKEN=
